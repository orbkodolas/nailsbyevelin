# SLOT_STEP_MINUTES=30
# BUFFER_MINUTES=15

# --- Szabályok ---
DEPOSIT_PERCENT=0                       # előleg % mindenkinek; meg nem jelenés után mindig 100% előre
# ONLINE_HOLD_MINUTES=30                # online fizetésnél ennyi ideig tartja az időpontot
# MANUAL_HOLD_HOURS=24                  # átutalásnál

# --- Értesítések ---
FORMSUBMIT_EMAIL=evelin@example.com     # Evelinnek érkező értesítések
# RESEND_API_KEY=                       # vendég e-mailek + emlékeztetők (resend.com)
# MAIL_FROM="Nails by Evelin <foglalas@a-te-domained.hu>"

